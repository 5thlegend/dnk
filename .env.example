# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Discord ---
DISCORD_PUBLIC_KEY=
DISCORD_APPLICATION_ID=
DISCORD_BOT_TOKEN=

# --- Resend ---
RESEND_API_KEY=
DIGEST_FROM_EMAIL=engine@yourdomain.com
DIGEST_TO_EMAIL=

# --- LLM ---
# "cloudflare" (free, Workers AI) or "anthropic" (Opus 4.7)
LLM_PROVIDER=cloudflare
ANTHROPIC_API_KEY=

# --- Dashboard ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Typefully (optional — auto-schedules X posts/threads) ---
# Settings → Integrations → API in Typefully
TYPEFULLY_API_KEY=

# --- GitHub webhook (optional — auto-ingest commits as transmissions) ---
# Set this to any random string, paste the same string into the GitHub
# webhook "Secret" field.
GITHUB_WEBHOOK_SECRET=

# --- Generic webhook (optional — Zapier/Make/Linear/Notion ingest) ---
# Random string; pass as ?key=... or x-ingest-key header on POSTs to
# /api/ingest/webhook
INGEST_WEBHOOK_KEY=

# --- Cron (optional — protects the /api/cron/digest endpoint) ---
CRON_SECRET=
